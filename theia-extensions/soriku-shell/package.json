{
  "name": "soriku-shell-ext",
  "version": "0.1.0",
  "description": "Soriku IDE — 1:1 desktop shell: custom titlebar, unified sidebar, statusbar/palette theming",
  "keywords": [
    "theia-extension"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/application-package": "1.73.0-next.2",
    "@theia/core": "1.73.0-next.2",
    "@theia/filesystem": "1.73.0-next.2",
    "@theia/navigator": "1.73.0-next.2",
    "@theia/workspace": "1.73.0-next.2",
    "inversify": "^6.2.2",
    "soriku-auth-ext": "0.1.0",
    "soriku-theme-ext": "0.1.0",
    "soriku-workbench-ext": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^2.7.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "test": "yarn build && node --test lib/test/**/*.spec.js",
    "lint": "eslint --ext js,jsx,ts,tsx src",
    "lint:fix": "eslint --ext js,jsx,ts,tsx src --fix",
    "watch": "tsc -w",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/soriku-shell-frontend-module"
    }
  ]
}
